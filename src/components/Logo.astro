---
const { text = true } = Astro.props;
---
<span class="inline-flex items-center gap-3">
  <svg width="38" height="38" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
    <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6E8BFF"/><stop offset="1" stop-color="#2F5BFF"/></linearGradient></defs>
    <rect width="64" height="64" rx="16" fill="url(#lg)"/>
    <g fill="none" stroke="#fff" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 24.5A11 11 0 1 0 33.5 33H24"/>
      <path d="M40 21h3a11 11 0 0 1 0 22h-3z"/>
    </g>
  </svg>
  {text && <span class="font-display font-extrabold tracking-tight text-[0.95rem] leading-none">Gill-christ <span class="text-[var(--color-accent-light)]">Djahoui</span></span>}
</span>
