---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
const scenarios = [
  ['Ils ne trouvent rien.', 'Ils prennent le suivant.'],
  ['Ils trouvent un site vieux, lent ou illisible sur téléphone.', 'Ils doutent, et ils partent.'],
  ['Ils trouvent un joli site, mais ne savent pas quoi faire.', 'Ils ferment la page.'],
];
---
<section id="probleme" class="section alt">
  <div class="wrap">
    <SectionHead ghost="Problème">LE PROBLÈME :</SectionHead>
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
      <div class="card reveal p-7 lg:p-10 flex flex-col justify-center">
        <p class="text-[1.1rem] lg:text-[1.2rem]">Avant d'appeler, de réserver ou d'acheter, vos clients font tous la même chose : <b class="text-white ul-blue">ils vous cherchent sur Google.</b></p>
        <p class="mt-6 mb-4 text-[var(--color-muted)]">Et là, trois scénarios :</p>
        <ul class="grid gap-3">
          {scenarios.map(([a, b]) => (
            <li class="rounded-2xl border border-white/10 bg-white/[.03] px-5 py-4">
              <span class="block font-semibold">{a}</span>
              <span class="mt-1.5 flex items-center gap-2 text-[var(--color-muted)]"><span class="text-[var(--color-accent-light)]"><Icon name="arrow" size={18} /></span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Illustration : ce que voit un client qui vous cherche -->
      <div class="card reveal p-5 sm:p-7 flex flex-col justify-center overflow-hidden relative" style="background:radial-gradient(circle at 70% 20%,rgba(47,91,255,.28),var(--color-card) 65%)">
        <div class="flex items-center gap-3 rounded-full bg-white/95 text-[#202124] px-5 py-3 text-[.95rem] shadow-[0_10px_40px_-10px_rgba(0,0,0,.7)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5f6368" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          plombier urgent près de chez moi
        </div>
        <div class="mt-5 grid gap-3">
          <div class="rounded-2xl bg-white/[.07] border border-[var(--color-accent-light)]/40 p-4">
            <p class="text-[.72rem] text-[var(--color-accent-light)] font-bold tracking-wider uppercase">Votre concurrent</p>
            <p class="mt-1 font-semibold">Site clair · bouton « Appeler » · avis en avant</p>
            <p class="text-[var(--color-star)] text-sm mt-1">★★★★★ <span class="text-[var(--color-muted)]">il décroche l'appel</span></p>
          </div>
          <div class="rounded-2xl bg-white/[.03] border border-dashed border-white/20 p-4 opacity-70">
            <p class="text-[.72rem] text-[var(--color-muted)] font-bold tracking-wider uppercase">Vous</p>
            <p class="mt-1 font-semibold">Fiche vide · pas de site · lent sur téléphone</p>
            <p class="text-sm mt-1 text-[var(--color-muted)]">le client est déjà parti</p>
          </div>
        </div>
        <p class="mt-4 text-center text-[.72rem] text-[var(--color-muted)]">Illustration</p>
      </div>
    </div>

    <p class="reveal mt-12 text-center text-[1.15rem]">Conséquence : <b class="text-white">vous perdez des clients chaque semaine. Sans même le savoir.</b></p>
  </div>
</section>

<section id="avant-apres" class="section dome">
  <div class="wrap max-w-[960px]">
    <h3 class="reveal text-center font-display font-extrabold uppercase text-[clamp(1.5rem,5vw,2.6rem)] leading-tight">
      Vos concurrents se font choisir. <span class="serif">Même quand vous travaillez mieux qu'eux.</span>
    </h3>
    <span class="h2-line" aria-hidden="true"></span>
    <!-- Avant / après : curseur glissant. Dépose before.webp / after.webp dans public/images/ pour activer les vraies captures -->
    <figure class="reveal mt-12">
      <div id="ba" class="glow-frame relative select-none touch-pan-y rounded-3xl overflow-hidden border border-white/10 aspect-[16/10] bg-[#0b1020]" style="--pos:50%">
        <div class="absolute inset-0 grid place-items-center after-layer" style="background:linear-gradient(135deg,#0f1b4d,#1a2f8f)">
          <div class="w-[78%] max-w-[480px] text-center"><div class="h-3 w-1/3 mx-auto rounded bg-white/30 mb-4"></div><div class="h-6 w-4/5 mx-auto rounded bg-white/90 mb-2"></div><div class="h-6 w-3/5 mx-auto rounded bg-white/50 mb-5"></div><div class="h-9 w-2/5 mx-auto rounded-full bg-[var(--color-accent-light)]"></div></div>
          <span class="absolute right-4 top-4 text-xs font-bold tracking-widest bg-[var(--color-accent)] px-3 py-1.5 rounded-full">APRÈS</span>
        </div>
        <div class="absolute inset-0 grid place-items-center before-layer" style="background:#3a3d46;clip-path:inset(0 calc(100% - var(--pos)) 0 0)">
          <div class="w-[78%] max-w-[480px]"><div class="h-3 w-2/3 rounded bg-white/25 mb-3"></div><div class="h-3 w-full rounded bg-white/15 mb-2"></div><div class="h-3 w-5/6 rounded bg-white/15 mb-2"></div><div class="h-3 w-2/3 rounded bg-white/15"></div></div>
          <span class="absolute left-4 top-4 text-xs font-bold tracking-widest bg-black/60 px-3 py-1.5 rounded-full">AVANT</span>
        </div>
        <div class="absolute top-0 bottom-0 w-[3px] bg-white pointer-events-none" style="left:var(--pos);transform:translateX(-50%)">
          <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white text-[#0a1a66] grid place-items-center font-bold shadow-xl">⇄</span>
        </div>
        <input type="range" min="0" max="100" value="50" aria-label="Comparer avant et après la refonte" class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize" id="ba-range" />
      </div>
      <figcaption class="mt-3 text-center text-sm text-[var(--color-muted)]">Glissez pour comparer. <span class="opacity-70">(Captures réelles d'une refonte : à venir.)</span></figcaption>
    </figure>
    <p class="reveal mt-12 text-center text-[1.15rem]">Bonne nouvelle : <b class="text-[var(--color-accent-light)]">ça se règle vite.</b> Sans y passer vos soirées, et sans rien comprendre à la technique.</p>
  </div>
</section>
