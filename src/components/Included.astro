---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { INCLUDED } from '../data/site';
---
<section id="inclus" class="section">
  <div class="wrap">
    <SectionHead ghost="Inclus">CE QUE VOUS AVEZ <span class="serif">en plus :</span></SectionHead>
    <div class="grid sm:grid-cols-2 lg:grid-cols-6 gap-5">
      {INCLUDED.map((x, i) => (
        <div class={`card reveal overflow-hidden ${i >= 3 ? 'lg:col-span-3' : 'lg:col-span-2'}`}>
          <div class="relative h-[130px] grid place-items-center overflow-hidden" style="background:radial-gradient(circle at 50% 40%,rgba(47,91,255,.4),#0a0e1c 75%)">
            <span class="grid place-items-center w-14 h-14 rounded-full bg-[var(--color-accent)]/15 border border-[var(--color-accent-light)]/40 text-[var(--color-accent-light)]"><Icon name={x.icon} size={28} /></span>
            <span class="badge-pill !bottom-3">Inclus</span>
          </div>
          <div class="p-7 text-center">
            <h3 class="font-extrabold text-[1.1rem] mb-2"><span class="ttl-ul">{x.title}</span></h3>
            <p class="text-[var(--color-muted)] text-[.97rem]">{x.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center reveal"><a class="btn" href="#contact" data-track="Devis" data-where="inclus">Demander mon devis gratuit <span class="arr"><Icon name="arrow" size={20} /></span></a></div>
  </div>
</section>
