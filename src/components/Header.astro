---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE, whatsappUrl } from '../data/site';
---
<header class="fixed top-3 inset-x-0 z-50 px-3">
  <div class="mx-auto max-w-[1100px]">
    <nav class="flex items-center justify-between gap-3 rounded-full border border-white/10 bg-[#0a0e1c]/70 backdrop-blur-xl pl-4 pr-2 py-2 shadow-[0_10px_40px_-15px_rgba(0,0,0,.9)]" aria-label="Navigation principale">
      <a href="#accueil" aria-label="Accueil — Gill-christ Djahoui"><Logo /></a>
      <ul class="hidden lg:flex items-center gap-7 text-[.92rem] font-medium text-[var(--color-muted)]">
        {NAV.map((l) => <li><a class="hover:text-white transition-colors" href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <a class="btn sm hidden lg:inline-flex" href={SITE.calendly} target="_blank" rel="noopener" data-track="Calendly" data-where="menu">Réserver un appel</a>
        <a class="btn sm lg:hidden" href="#contact" data-track="Devis" data-where="menu-mobile">Devis gratuit</a>
        <button id="burger" class="lg:hidden grid place-items-center w-11 h-11 rounded-full border border-white/12 text-white" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-panel">
          <span class="icon-open"><Icon name="menu" size={22} /></span>
          <span class="icon-close hidden"><Icon name="close" size={22} /></span>
        </button>
      </div>
    </nav>
    <div id="mobile-panel" class="mobile-panel mt-2 rounded-3xl border border-white/10 bg-[#0a0e1c]/95 backdrop-blur-xl p-3 lg:hidden">
      <ul class="flex flex-col">
        {NAV.map((l) => <li><a class="block px-4 py-3.5 rounded-2xl text-[1.02rem] font-semibold hover:bg-white/5" href={l.href}>{l.label}</a></li>)}
        <li><a class="block px-4 py-3.5 rounded-2xl text-[1.02rem] font-semibold hover:bg-white/5" href={SITE.calendly} target="_blank" rel="noopener" data-track="Calendly" data-where="menu-mobile">Réserver un appel</a></li>
      </ul>
    </div>
  </div>
</header>

<div class="fixed bottom-0 inset-x-0 z-40 bg-[var(--color-accent)] shadow-[0_-10px_40px_-10px_rgba(47,91,255,.6)]" role="region" aria-label="Demander un devis">
  <div class="mx-auto max-w-[1180px] px-4 py-3 flex items-center justify-center md:justify-between gap-3">
    <p class="hidden md:block font-semibold text-[.98rem]">Devis gratuit et sans engagement <span class="opacity-60 mx-2">·</span> Réponse sous 24h</p>
    <div class="flex w-full md:w-auto gap-2.5">
      <a href="#contact" class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 min-h-[46px] px-6 rounded-full bg-white text-[#0a1a66] font-bold text-[.95rem] hover:bg-[#e8edff] transition-colors" data-track="Devis" data-where="barre">Demander mon devis <Icon name="arrow" size={18} /></a>
      <a href={whatsappUrl()} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp" class="inline-flex items-center justify-center gap-2 min-h-[46px] min-w-[46px] px-4 rounded-full border-2 border-white/70 text-white font-bold hover:bg-white/15 transition-colors" data-track="WhatsApp" data-where="barre"><Icon name="whatsapp" size={22} /><span class="md:inline hidden">WhatsApp</span></a>
    </div>
  </div>
</div>
