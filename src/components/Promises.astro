---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { PROMISES } from '../data/site';
---
<section id="engagements" class="section alt">
  <div class="wrap max-w-[900px]">
    <SectionHead ghost="Promesses">CE QUE JE NE VOUS PROMETTRAI <span class="serif">jamais</span></SectionHead>
    <div class="reveal flex justify-center mb-10" aria-hidden="true">
      <div class="relative inline-flex items-center gap-3 px-6 py-4 rounded-2xl border border-white/12 bg-[var(--color-card)] text-[var(--color-muted)] font-display font-extrabold text-[1.05rem] sm:text-[1.3rem] rotate-[-2deg]">
        <span class="text-[var(--color-star)]">★</span> 1er sur Google garanti !
        <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M3 4L97 36M97 4L3 36" stroke="#FF4D4D" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" fill="none" /></svg>
      </div>
    </div>
    <p class="reveal text-center text-[1.05rem] text-[var(--color-muted)]">« 100 clients en 30 jours », « première place sur Google garantie » : ces promesses, vous les trouverez ailleurs. <b class="text-white">Personne d'honnête ne peut les tenir.</b></p>
    <h3 class="reveal mt-12 mb-6 text-center font-display font-extrabold text-[1.3rem]">Ce que je vous promets, <span class="serif text-[1.2em]">en revanche :</span></h3>
    <ul class="grid">
      {PROMISES.map((p) => (
        <li class="reveal py-4 border-b border-white/10 flex items-start gap-4"><span class="mt-1 shrink-0 w-6 h-6 rounded-full bg-[var(--color-accent)]/20 grid place-items-center text-[var(--color-accent-light)]"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>{p}</span></li>
      ))}
    </ul>
  </div>
</section>
