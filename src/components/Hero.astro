---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import { SITE, PROJECTS } from '../data/site';
const [p1, p2, p3] = PROJECTS;
---
<section id="accueil" class="relative overflow-hidden pt-32 pb-24 lg:pt-40 lg:pb-36">
  <div class="stars"></div>
  <div class="halo" style="top:34%"></div>
  <div class="horizon"></div>
  <div class="wrap relative z-10 text-center">
    <span class="inline-block mb-7 px-4 py-2 rounded-full border border-white/15 bg-white/[.04] text-[.68rem] sm:text-[.76rem] font-bold tracking-[.18em] text-[var(--color-accent-light)]">COMMERÇANTS · ARTISANS · INDÉPENDANTS · PME</span>
    <h1 class="mx-auto max-w-[980px] font-display font-extrabold uppercase leading-[1.06] tracking-[-0.012em] text-[clamp(1.85rem,6.4vw,3.6rem)]">
      Vos clients vous cherchent sur <span class="ttl-ul">Google.</span> Donnez-leur <span class="serif text-[1.14em]">envie</span> de vous appeler.
    </h1>
    <p class="mt-6 text-[var(--color-muted)] max-w-[40rem] mx-auto text-[1.02rem] lg:text-[1.15rem]">
      Je crée et je refais des sites web qui donnent envie de vous appeler, de réserver ou d'acheter. Beaux sur mobile, visibles sur Google, livrés vite et à prix fixe.
    </p>
    <div class="mt-9 flex flex-col sm:flex-row gap-3.5 justify-center">
      <a href="#contact" class="btn" data-track="Devis" data-where="hero">Demander mon devis gratuit <span class="arr"><Icon name="arrow" size={20} /></span></a>
      <a href="#realisations" class="btn ghost-btn">Voir mes réalisations</a>
    </div>
    <ul class="mt-8 flex flex-col sm:flex-row flex-wrap gap-x-8 gap-y-2 justify-center text-[.92rem] text-[var(--color-muted)]">
      <li class="flex items-center gap-2 justify-center"><span class="text-[var(--color-accent-light)]">✦</span><b class="text-white">{SITE.sitesDelivered}</b> sites livrés</li>
      <li class="flex items-center gap-2 justify-center"><span class="text-[var(--color-accent-light)]">✦</span>Réponse sous 24h</li>
      <li class="flex items-center gap-2 justify-center"><span class="text-[var(--color-accent-light)]">✦</span>Prix fixe, annoncé avant de commencer</li>
    </ul>

    <!-- Grand cadre visuel sous les boutons (comme la référence) -->
    <div class="relative mx-auto mt-14 lg:mt-20 max-w-[980px]" aria-hidden="true">
      <div class="frame-pc glow-frame float-a"><div class="bar"><i></i><i></i><i></i></div><div class="scr"><Shot image={p1.image} label={p1.name} eager /></div></div>
      <div class="absolute -right-1 sm:-right-6 -bottom-8 w-[22%] max-w-[190px] float-b">
        <div class="frame-ph"><div class="scr"><Shot image={p2.image} label={p2.name} device="ph" eager /></div></div>
      </div>
      <div class="absolute -left-6 -bottom-8 w-[30%] float-b hidden md:block">
        <div class="frame-pc"><div class="bar"><i></i><i></i><i></i></div><div class="scr"><Shot image={p3.image} label={p3.name} eager /></div></div>
      </div>
    </div>
  </div>
</section>
