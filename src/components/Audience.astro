---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { AUDIENCES } from '../data/site';
---
<section id="pour-qui" class="section">
  <div class="wrap">
    <SectionHead ghost="Pour qui" id="t-pourqui">
      Vous êtes<span class="serif">...</span> ?
      <p slot="lead" class="lead">Chaque métier a son problème. Voici comment un bon site le règle.</p>
    </SectionHead>
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {AUDIENCES.map((a) => (
        <article id={a.id} class="card reveal overflow-hidden flex flex-col">
          <div class="relative h-[190px] lg:h-[220px] grid place-items-center overflow-hidden" style="background:radial-gradient(circle at 50% 38%,rgba(47,91,255,.45),#0a0e1c 72%)">
            <div class="stars opacity-50"></div>
            <span class="relative grid place-items-center w-20 h-20 rounded-full bg-[var(--color-accent)]/15 border border-[var(--color-accent-light)]/40 text-[var(--color-accent-light)] shadow-[0_0_50px_-4px_rgba(47,91,255,.8)]"><Icon name={a.icon} size={40} /></span>
            <span class="badge-pill">{a.title}</span>
          </div>
          <div class="p-7 lg:p-9 flex flex-col flex-1">
            <ul class="flex flex-wrap gap-2 mb-6">{a.tags.map((t) => <li class="pill">{t}</li>)}</ul>
            <p class="text-[var(--color-muted)] mb-4"><b class="text-white font-semibold">Le problème. </b>{a.problem}</p>
            <p class="mb-7"><b class="text-[var(--color-accent-light)] font-semibold">Ce que je fais. </b>{a.solution}</p>
            <a class="btn sm mt-auto self-start" href={`?activite=${a.activite}#contact`} data-activite={a.activite} data-track="Cest-mon-cas" data-where={a.id}>C'est mon cas <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      ))}
    </div>

    <div class="cta-row reveal"><a class="btn" href="#contact" data-track="Devis" data-where="pour-qui">Demander mon devis gratuit <span class="arr"><Icon name="arrow" size={20} /></span></a></div>
  </div>
</section>
