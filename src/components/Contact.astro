---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { SITE, ACTIVITES, BESOINS, whatsappUrl } from '../data/site';
---
<section id="contact" class="section alt relative overflow-hidden">
  <div class="halo" style="top:30%"></div>
  <div class="wrap relative">
    <SectionHead ghost="Contact">PRÊT À AVOIR UN SITE QUI VOUS RAMÈNE <span class="serif">des clients ?</span>
      <p slot="lead" class="lead">Envoyez-moi deux lignes sur votre activité. Je vous réponds sous 24h avec une première idée et un prix.</p>
    </SectionHead>

    <div class="reveal flex flex-col md:flex-row justify-center gap-3.5 max-w-[860px] mx-auto">
      <a class="btn" href="#formulaire" data-track="Devis" data-where="contact">Demander mon devis gratuit</a>
      <a class="btn ghost-btn" href={SITE.calendly} target="_blank" rel="noopener" data-track="Calendly" data-where="contact"><Icon name="calendar" size={20} /> Réserver un appel de 20 min</a>
      <a class="btn wa" href={whatsappUrl()} target="_blank" rel="noopener" data-track="WhatsApp" data-where="contact"><Icon name="whatsapp" size={22} /> Écrire sur WhatsApp</a>
    </div>
    <p class="reveal mt-5 text-center text-sm text-[var(--color-muted)]">Gratuit · Sans engagement · Réponse sous 24h</p>

    <form id="formulaire" class="card reveal mt-14 max-w-[760px] mx-auto p-6 sm:p-10 scroll-mt-28" action="https://api.web3forms.com/submit" method="POST" novalidate>
      <h3 class="font-display font-extrabold uppercase text-[1.4rem] mb-7 text-center">Demande de devis gratuit</h3>
      <input type="hidden" name="access_key" value={SITE.web3formsKey} />
      <input type="hidden" name="subject" value="Nouvelle demande de devis — gdjahoui.com" />
      <input type="hidden" name="from_name" value="gdjahoui.com" />
      <input type="hidden" name="source" id="f-source" value="" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="grid sm:grid-cols-2 gap-5">
        <div class="field"><label for="f-prenom">Prénom *</label><input id="f-prenom" name="prenom" required autocomplete="given-name" /></div>
        <div class="field"><label for="f-ent">Nom de votre entreprise *</label><input id="f-ent" name="entreprise" required autocomplete="organization" /></div>
        <div class="field"><label for="f-email">Email *</label><input id="f-email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
        <div class="field"><label for="f-tel">Téléphone / WhatsApp</label><input id="f-tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" /></div>
        <div class="field"><label for="f-act">Votre activité *</label>
          <select id="f-act" name="activite" required><option value="" disabled selected>Choisir…</option>{ACTIVITES.map((a) => <option value={a.value}>{a.label}</option>)}</select></div>
        <div class="field"><label for="f-besoin">Ce dont vous avez besoin *</label>
          <select id="f-besoin" name="besoin" required><option value="" disabled selected>Choisir…</option>{BESOINS.map((a) => <option value={a.value}>{a.label}</option>)}</select></div>
        <fieldset class="field sm:col-span-2">
          <legend class="mb-2 text-[.88rem] font-semibold">Vous avez déjà un site ?</legend>
          <div class="flex gap-6">
            <label class="!mb-0 flex items-center gap-2 font-medium"><input class="!w-5 !min-h-0 !h-5 accent-[var(--color-accent)]" type="radio" name="site_existant" value="non" checked /> Non</label>
            <label class="!mb-0 flex items-center gap-2 font-medium"><input class="!w-5 !min-h-0 !h-5 accent-[var(--color-accent)]" type="radio" name="site_existant" value="oui" /> Oui</label>
          </div>
        </fieldset>
        <div class="field sm:col-span-2 hidden" id="f-url-wrap"><label for="f-url">Lien de votre site</label><input id="f-url" name="lien_site" type="url" inputmode="url" placeholder="https://" /></div>
        <div class="field sm:col-span-2"><label for="f-msg">Votre message</label><textarea id="f-msg" name="message" placeholder="Je suis fleuriste à Tours, je veux que mes clients puissent commander en ligne."></textarea></div>
        <label class="sm:col-span-2 flex items-start gap-3 text-[.92rem] text-[var(--color-muted)] cursor-pointer">
          <input class="mt-1 w-5 h-5 shrink-0 accent-[var(--color-accent)]" type="checkbox" name="consentement" value="oui" required />
          <span>J'accepte d'être recontacté au sujet de ma demande.</span>
        </label>
      </div>
      <button type="submit" class="btn w-full mt-8">Recevoir mon devis gratuit <span class="arr"><Icon name="arrow" size={20} /></span></button>
      <p class="mt-4 text-center text-sm text-[var(--color-muted)]">Réponse sous 24h. Sans engagement. Vos informations restent entre nous.</p>
      <p id="f-status" class="mt-4 text-center font-semibold" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
