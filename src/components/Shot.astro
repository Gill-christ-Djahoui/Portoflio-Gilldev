---
import { Image } from 'astro:assets';
const { image = '', label = '', device = 'pc', eager = false } = Astro.props;
const files = import.meta.glob('/src/assets/projects/*.{png,jpg,jpeg,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const found = image ? files[`/src/assets/projects/${image}`]?.default : undefined;
---
{found ? (
  <Image src={found} alt={`Capture du projet ${label}`} widths={[400, 700, 1000]} sizes="(min-width:1024px) 520px, 90vw" format="webp" quality={90} loading={eager ? 'eager' : 'lazy'} />
) : (
  <div class="ph-shot" role="img" aria-label={`Capture à venir : ${label}`}>
    <div class="w-full max-w-[85%]">
      <div class="h-2 w-1/3 rounded bg-white/15 mx-auto mb-3"></div>
      <div class="h-5 w-4/5 rounded bg-[var(--color-accent)]/50 mx-auto mb-2"></div>
      <div class="h-5 w-3/5 rounded bg-white/10 mx-auto mb-4"></div>
      <div class="h-6 w-1/3 rounded-full bg-[var(--color-accent)]/70 mx-auto mb-5"></div>
      {device === 'pc' && <div class="grid grid-cols-3 gap-2"><div class="h-10 rounded bg-white/8"></div><div class="h-10 rounded bg-white/8"></div><div class="h-10 rounded bg-white/8"></div></div>}
      <p class="mt-3 font-semibold text-[10px] uppercase tracking-widest text-white/50">{label}</p>
    </div>
  </div>
)}
