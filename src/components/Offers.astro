---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { OFFERS, OPTIONS } from '../data/site';
const art: Record<string, string> = {
  vitrine: '<rect x="14" y="20" width="132" height="84" rx="8"/><path d="M14 38h132"/><circle cx="26" cy="29" r="2.4"/><circle cx="35" cy="29" r="2.4"/><path d="M30 56h60M30 68h90M30 80h44"/><rect x="96" y="76" width="38" height="16" rx="8"/>',
  refonte: '<rect x="10" y="26" width="64" height="70" rx="7" opacity=".5"/><path d="M18 44h48M18 56h36M18 68h42" opacity=".5"/><path d="M80 61h20M92 53l8 8-8 8"/><rect x="104" y="18" width="50" height="86" rx="9"/><path d="M114 40h30M114 54h24M114 68h30"/><rect x="114" y="82" width="30" height="12" rx="6"/>',
  boutique: '<path d="M30 40h100l-10 52H40z"/><path d="M52 40c0-14 10-22 28-22s28 8 28 22"/><circle cx="62" cy="108" r="6"/><circle cx="108" cy="108" r="6"/><path d="M64 62h44M68 76h36"/>',
  maintenance: '<path d="M80 18l48 18v34c0 20-16 32-48 42-32-10-48-22-48-42V36z"/><path d="M58 66l16 16 30-32"/>',
};
---
<section id="offres" class="section alt">
  <div class="wrap">
    <SectionHead ghost="Offres" id="t-offres">
      MES OFFRES :
      <p slot="lead" class="lead">4 offres claires. Un prix de départ affiché. Un prix fixe, écrit dans le devis, avant de commencer.</p>
    </SectionHead>
    <div class="grid gap-6 lg:gap-8">
      {OFFERS.map((o, i) => (
        <article id={`offre-${o.id}`} class="card reveal overflow-hidden grid lg:grid-cols-2">
          <div class={`relative min-h-[230px] lg:min-h-[420px] grid place-items-center overflow-hidden ${i % 2 ? 'lg:order-2' : ''}`} style="background:radial-gradient(circle at 50% 40%,rgba(47,91,255,.35),#0a0e1c 70%)">
            <div class="stars opacity-50"></div>
            <svg viewBox="0 0 160 120" class="relative w-[62%] max-w-[300px] text-[var(--color-accent-light)] float-a" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={art[o.id]} />
            <span class="absolute left-5 top-5 font-display font-extrabold text-[3.4rem] leading-none text-transparent" style="-webkit-text-stroke:1px rgba(255,255,255,.22)">0{i + 1}</span>
          </div>
          <div class="p-7 lg:p-12 flex flex-col">
            <h3 class="font-display font-extrabold uppercase text-[1.6rem] lg:text-[2rem] leading-tight">{o.title}</h3>
            <p class="serif text-[1.35rem] mt-1">{o.hook}</p>
            <p class="mt-4 text-[var(--color-muted)]"><b class="text-white font-semibold">Pour qui : </b>{o.for}</p>
            <ul class="check mt-6 mb-8">{o.items.map((it) => <li>{it}</li>)}</ul>
            <div class="mt-auto flex flex-col sm:flex-row sm:items-center justify-between gap-5 pt-6 border-t border-white/10">
              <p class="font-display font-extrabold text-[1.7rem] lg:text-[2rem] leading-none">{o.price}</p>
              <a class="btn" href={`?besoin=${o.besoin}#contact`} data-besoin={o.besoin} data-track="Offre" data-where={o.id}>{o.cta} <span class="arr"><Icon name="arrow" size={20} /></span></a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal mt-12 text-center">
      <p class="font-semibold text-[1.05rem]">En deux fois : <span class="text-[var(--color-accent-light)]">50 % au démarrage, 50 % à la livraison.</span></p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2.5" aria-label="Options sur devis">
        {OPTIONS.map((o) => <li class="pill !text-[.85rem] !px-4 !py-2">{o} <span class="opacity-60">· sur devis</span></li>)}
      </ul>
      <p class="mt-8 text-[var(--color-muted)]">Un besoin plus spécifique (espace client, outil interne) ? Parlons-en. <a class="text-[var(--color-accent-light)] font-semibold underline underline-offset-4" href="#contact">Écrivez-moi →</a></p>
    </div>
  </div>
</section>
