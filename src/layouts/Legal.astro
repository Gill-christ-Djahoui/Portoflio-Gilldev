---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
const { title, description } = Astro.props;
---
<Base title={`${title} | Gill-christ Djahoui`} description={description} noindex={false}>
  <header class="border-b border-white/10"><div class="wrap py-5 flex items-center justify-between"><a href="/" aria-label="Retour à l'accueil"><Logo /></a><a class="text-sm text-[var(--color-accent-light)] font-semibold" href="/">← Retour au site</a></div></header>
  <main class="wrap max-w-[780px] py-16 lg:py-24">
    <h1 class="font-display font-extrabold uppercase text-[clamp(1.8rem,6vw,2.8rem)] mb-10">{title}</h1>
    <div class="legal text-[var(--color-muted)] [&_h2]:text-white [&_h2]:font-display [&_h2]:font-extrabold [&_h2]:text-xl [&_h2]:mt-10 [&_h2]:mb-3 [&_p]:mb-4 [&_a]:text-[var(--color-accent-light)] [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4"><slot /></div>
  </main>
  <footer class="border-t border-white/10 py-8 text-center text-sm text-[var(--color-muted)]">© 2026 Gill-christ Djahoui. Tous droits réservés.</footer>
</Base>
